# SDN-R Database
SDNRDB_IMAGE=mariadb:10.11
SDNRDB_USERNAME=sdnrdb
SDNRDB_PASSWORD=sdnrdb
SDNC_IMAGE=nexus3.onap.org:10001/onap/sdnc-image:3.2.4
SDNC_WEB_IMAGE=nexus3.onap.org:10001/onap/sdnc-web-image:3.2.4
ADMIN_PASSWORD=admin
VES_COLLECTOR_IMAGE=nexus3.onap.org:10001/onap/org.onap.dcaegen2.collectors.ves.vescollector:1.12.6
KAFKA_IMAGE=quay.io/strimzi/kafka:0.47.0-kafka-3.9.1
ZOOKEEPER_IMAGE=quay.io/strimzi/kafka:0.47.0-kafka-3.9.1
# Password-only NETCONF SSH user that SDNC mounts the netconf server with
NETCONF_SSH_USERNAME=sdnr
NETCONF_SSH_PASSWORD=sdnr
